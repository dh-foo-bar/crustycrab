---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { url, sectionize } from "../../lib/site";
import { atomArt, elementSymbols } from "../../lib/art";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const recipes = (await getCollection("recipes")).sort((a, b) => a.data.title.localeCompare(b.data.title));
  const symbols = elementSymbols(recipes.map((r) => r.data.title));
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe, symbol: symbols.get(recipe.data.title)! } }));
}

const { recipe, symbol } = Astro.props;
const d = recipe.data;
const body = sectionize(recipe.rendered?.html ?? "");
// Longer recipes print with tighter type so they still fit one page.
const length = (recipe.body ?? "").length;
const density = length > 2950 ? "dense" : length > 2850 ? "compact" : "normal";

const specs = [
  { value: d.kcal, unit: "kcal", label: "Calories", icon: "energy" },
  { value: d.protein_g, unit: "g", label: "Protein", icon: "protein" },
  { value: d.carbs_g, unit: "g", label: "Carbs", icon: "carbs" },
  { value: d.fat_g, unit: "g", label: "Fat", icon: "fat" },
  { value: d.time_total.replace(/\s*min$/, ""), unit: /min$/.test(d.time_total) ? "min" : "", label: d.time_active ? `Total, ${d.time_active} active` : "Total time", icon: "time" },
  { value: d.servings, unit: "", label: "Servings", icon: "servings" },
];
---
<Base title={d.title} description={d.summary}>
  <article class="recipe" data-density={density}>
    <header class="recipe-hero">
      <div class="wrap recipe-hero-inner">
        <div class="recipe-art" set:html={atomArt(recipe.id, "hero")} />
        <div class="recipe-hero-text">
        <a class="back" href={url("/#recipes")}>Recipes</a>
        <p class="tags"><span class="tag-element" aria-hidden="true">{symbol}</span><span>{d.cuisine}</span><span>{d.protein_detail}</span></p>
        <h1 class="recipe-title">{d.title}</h1>
        <p class="lede">{d.summary}</p>
        </div>
      </div>
    </header>

    <div class="wrap">
      <dl class="specs" aria-label="Per serving and timing">
        {specs.map((s) => (
          <div class="spec">
            <dt><Icon name={s.icon} />{s.label}</dt>
            <dd><span class="spec-num">{s.value}</span>{s.unit && <span class="spec-unit">{s.unit}</span>}</dd>
          </div>
        ))}
      </dl>
      <p class="specs-note">Nutrition is per serving.</p>

      <div class="actions">
        {d.shop && <button type="button" class="btn" id="add-list" data-slug={recipe.id} aria-pressed="false">Add to shopping list</button>}
        <button type="button" class="btn" id="print">Print recipe</button>
        <button type="button" class="btn" id="wake" aria-pressed="false" hidden>Keep screen on</button>
      </div>

      <div class="recipe-body" set:html={body} />
    </div>
  </article>

  <script>
    import { readSelection, toggleSelection } from "../../lib/shopping";

    document.getElementById("print")!.addEventListener("click", () => window.print());

    // Add this recipe to the shopping list selection.
    const add = document.getElementById("add-list") as HTMLButtonElement | null;
    const syncAdd = () => {
      if (!add) return;
      const on = readSelection().includes(add.dataset.slug!);
      add.setAttribute("aria-pressed", String(on));
      add.textContent = on ? "On shopping list" : "Add to shopping list";
    };
    add?.addEventListener("click", () => toggleSelection(add.dataset.slug!));
    window.addEventListener("selection-change", syncAdd);
    window.addEventListener("pageshow", syncAdd);
    syncAdd();

    // Tap an ingredient to check it off while cooking.
    for (const li of document.querySelectorAll<HTMLLIElement>(".sec-ingredients li")) {
      li.setAttribute("role", "checkbox");
      li.setAttribute("aria-checked", "false");
      li.tabIndex = 0;
      const toggle = () => li.setAttribute("aria-checked", String(li.getAttribute("aria-checked") !== "true"));
      li.addEventListener("click", toggle);
      li.addEventListener("keydown", (e) => {
        if (e.key === " " || e.key === "Enter") { e.preventDefault(); toggle(); }
      });
    }

    // Keep the screen awake while cooking, where the browser supports it.
    const wake = document.getElementById("wake") as HTMLButtonElement;
    if ("wakeLock" in navigator) {
      wake.hidden = false;
      let lock: WakeLockSentinel | null = null;
      const set = (on: boolean) => {
        wake.setAttribute("aria-pressed", String(on));
        wake.textContent = on ? "Screen stays on" : "Keep screen on";
      };
      const acquire = async () => {
        try {
          lock = await navigator.wakeLock.request("screen");
          set(true);
          lock.addEventListener("release", () => { if (document.visibilityState === "visible") set(false); });
        } catch { set(false); }
      };
      wake.addEventListener("click", async () => {
        if (wake.getAttribute("aria-pressed") === "true") { await lock?.release(); lock = null; set(false); }
        else await acquire();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible" && wake.getAttribute("aria-pressed") === "true") acquire();
      });
    }
  </script>
</Base>
